{
  "manifest_version": 3,
  "name": "Universal Copy",
  "version": "1.0.0",
  "description": "Bypass copy restrictions on restricted websites. Unlock right-click, text selection, and keyboard shortcuts.",
  "icons": {
    "128": "icon.svg"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.svg"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["unlocker.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "toggle-unlock": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle page unlock"
    },
    "quick-copy": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy all text from page"
    }
  }
}